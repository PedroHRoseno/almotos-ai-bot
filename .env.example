# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false

# WhatsApp Business (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao_do_webhook
WHATSAPP_ACCESS_TOKEN=seu_token_de_acesso_da_meta
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=seu_app_secret_meta

# Agent runtime (almotos-ai). OpenAI e estoque Kotlin saem deste processo.
ALMOTOS_AI_URL=http://localhost:3100

# Memória de conversa vive no almotos-ai (REDIS_URL lá). Opcional aqui só para docs.
REDIS_URL=

# Vendedores (handoff continua configurado no almotos-ai)
SELLER_1_PHONE=5581999999999
SELLER_2_PHONE=5581888888888
