# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false

# WhatsApp Business (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao_do_webhook
WHATSAPP_ACCESS_TOKEN=seu_token_de_acesso_da_meta
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=seu_app_secret_meta

# Orquestrador (ADR-003). OpenAI e estoque Kotlin saem deste processo.
ALMOTOS_AI_URL=http://localhost:3100

# SoR — lista de espera (polling; padrão 1 min)
ALMOTOS_BACKEND_URL=http://localhost:8080
INTERNAL_API_KEY=
# Opcional. Padrão 1. Suba para 30 depois do teste em produção.
WISHLIST_POLL_INTERVAL_MINUTES=1

# Chatwoot (caixa omnichannel — AgentBot webhook + API)
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_API_TOKEN=seu_api_access_token_do_agent_bot
CHATWOOT_ACCOUNT_ID=1

# Evolution API (legado — inbound é ignorado se o Chatwoot estiver configurado)
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=sua_apikey_da_evolution
EVOLUTION_INSTANCE=nome_da_instancia
# Opcional: token da instância se for diferente da global (body.apikey da Evolution).
# EVOLUTION_WEBHOOK_SECRET=token_da_instancia
# true = 401 se a chave não bater. false = loga e processa (dev/e2e).
EVOLUTION_WEBHOOK_AUTH_REQUIRED=false

# Debounce: espera para juntar mensagens rápidas do mesmo conversation_id.
CHATWOOT_DEBOUNCE_SECONDS=4
